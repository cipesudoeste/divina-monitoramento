generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN MEMBER }
enum WorkspaceRole { OWNER ADMIN ANALYST }
enum SessionStatus { CREATED QR_READY CONNECTED DISCONNECTED ERROR }
enum MemberStatus { ACTIVE LEFT }
enum MembershipEventType { JOIN LEAVE }
enum FlowType { WELCOME EXIT }
enum InteractionStatus { SENT ANSWERED EXPIRED }

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userWorkspaces UserWorkspace[]
  auditLogs    AuditLog[]
}

model Workspace {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users UserWorkspace[]
  sessions WhatsappSession[]
  groups Group[]
  campaigns Campaign[]
  auditLogs AuditLog[]
}

model UserWorkspace {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  @@unique([userId, workspaceId])
}

model WhatsappSession {
  id                   String @id @default(cuid())
  workspaceId          String
  provider             String
  label                String
  status               SessionStatus @default(CREATED)
  phoneNumber          String?
  sessionBlobEncrypted String?
  lastSeenAt           DateTime?
  connectedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  groups Group[]
}

model Group {
  id              String @id @default(cuid())
  workspaceId     String
  sessionId       String
  externalGroupId String
  name            String
  description     String?
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  session WhatsappSession @relation(fields:[sessionId], references:[id], onDelete: Cascade)
  members GroupMember[]
  events MembershipEvent[]
  automationFlows AutomationFlow[]
  interactions AutomationInteraction[]
  snapshots DailyGroupSnapshot[]
  @@unique([sessionId, externalGroupId])
}

model GroupMember {
  id          String @id @default(cuid())
  groupId     String
  memberKey   String
  displayName String?
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group Group @relation(fields:[groupId], references:[id], onDelete: Cascade)
  @@unique([groupId, memberKey])
}

model MembershipEvent {
  id               String @id @default(cuid())
  groupId          String
  memberKey        String
  eventType        MembershipEventType
  eventAt          DateTime
  sourceCampaignId String?
  rawPayload       Json?
  createdAt        DateTime @default(now())
  group Group @relation(fields:[groupId], references:[id], onDelete: Cascade)
  campaign Campaign? @relation(fields:[sourceCampaignId], references:[id])
}

model Campaign {
  id             String @id @default(cuid())
  workspaceId    String
  name           String
  source         String?
  medium         String?
  content        String?
  inviteLink     String?
  landingPageUrl String?
  qrCodeUrl      String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  membershipEvents MembershipEvent[]
}

model AutomationFlow {
  id              String @id @default(cuid())
  groupId          String
  flowType         FlowType
  enabled          Boolean @default(true)
  title            String
  messageText      String
  delaySeconds     Int @default(30)
  allowFreeText    Boolean @default(false)
  activeStartHour  Int @default(0)
  activeEndHour    Int @default(23)
  timezone         String @default("America/Sao_Paulo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  group Group @relation(fields:[groupId], references:[id], onDelete: Cascade)
  options AutomationFlowOption[]
  @@unique([groupId, flowType])
}

model AutomationFlowOption {
  id       String @id @default(cuid())
  flowId    String
  value     String
  label     String
  position  Int
  flow AutomationFlow @relation(fields:[flowId], references:[id], onDelete: Cascade)
}

model AutomationInteraction {
  id            String @id @default(cuid())
  groupId        String
  memberKey      String
  flowType       FlowType
  messageSentAt  DateTime
  answeredAt     DateTime?
  answerValue    String?
  answerLabel    String?
  freeText       String?
  status         InteractionStatus @default(SENT)
  group Group @relation(fields:[groupId], references:[id], onDelete: Cascade)
}

model DailyGroupSnapshot {
  id           String @id @default(cuid())
  groupId      String
  snapshotDate DateTime
  memberCount  Int
  joinsCount   Int
  leavesCount  Int
  netGrowth    Int
  group Group @relation(fields:[groupId], references:[id], onDelete: Cascade)
  @@unique([groupId, snapshotDate])
}

model AuditLog {
  id          String @id @default(cuid())
  workspaceId String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  payload     Json?
  createdAt   DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  actorUser User? @relation(fields:[actorUserId], references:[id])
}
